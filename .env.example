TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=replace-with-client-secret

MAX_WORKERS=4
REQUEST_TIMEOUT=60

# Decoracao de trafego: SharePoint prioriza requisicoes com User-Agent no formato
# ISV|Empresa|App/Versao (parceiros) ou NONISV|Empresa|App/Versao (uso interno).
# Troque "SuaEmpresa" para identificar seu app e reduzir throttling (429/503).
GRAPH_USER_AGENT=NONISV|SuaEmpresa|SharePointStorageManager/1.0

# Pacing proativo: quando o header RateLimit-Remaining fica abaixo deste valor,
# os workers pausam por uma fracao da janela de reset antes de continuar.
RATE_LIMIT_MIN_REMAINING=20
SQLITE_DB_PATH=./inventory/sharepoint_inventory.sqlite3
EXPORT_PATH=./exports
LOG_LEVEL=INFO
PROGRESS_LOG_INTERVAL_SECONDS=60

# O comando crawl usa /root/delta por drive e salva nextLink/deltaLink no SQLite.
# Use resume para continuar uma execucao interrompida.
# Comece com 2 ou 4 workers para reduzir bloqueios temporarios do Graph.

# FULL_RESYNC=true forca recoleta completa dos sites descobertos (limpa itens e
# refaz a carga do zero). Deixe false para coleta incremental normal por delta.
FULL_RESYNC=false

# Opcional: inventariar OneDrive for Business de usuarios.
# Requer permissões extras, veja README.
ENABLE_USER_ONEDRIVE=false

# Use para limitar escopo em testes. Exemplo: contoso.sharepoint.com:/sites/Finance
SITE_SEARCH_QUERY=*

# Opcional: processar somente sites especificos, na ordem informada.
# Pode usar arquivos gerados pelo prioritize-sites, como ./exports/site_ids_over_1tb.txt
SITE_IDS_FILE=
SITE_IDS=

# O comando prioritize-sites requer Microsoft Graph Application Reports.Read.All.
